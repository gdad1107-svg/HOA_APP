{
  "name": "hoa-app",
  "version": "0.1.0",
  "private": true,
  "description": "HOA portal mock-up and its test automation",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test:ui": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
